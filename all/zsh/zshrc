# workmux wrapper: make `workmux add` always branch off a freshly-fetched
# origin/<default> (typically origin/main, but auto-detected so repos still
# on `master` work too). Other subcommands and explicit --base / --pr pass
# through unchanged.
workmux() {
  if [[ "$1" != "add" ]]; then
    command workmux "$@"
    return $?
  fi
  shift
  local args=("$@") arg
  # If user already passed --base or --pr, don't override.
  for arg in "${args[@]}"; do
    case "$arg" in
      --base|--base=*|--pr|--pr=*)
        command workmux add "${args[@]}"
        return $?
        ;;
    esac
  done
  # Detect the repo's default branch from origin/HEAD (e.g. main, master).
  local default_branch
  default_branch=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
  if [[ -z "$default_branch" ]]; then
    # Couldn't detect — fall through to plain `workmux add`.
    command workmux add "${args[@]}"
    return $?
  fi
  git fetch origin "$default_branch" --quiet 2>/dev/null
  command workmux add --base "origin/$default_branch" "${args[@]}"
}

# git worktree helpers (gwt/gwta/gwtls/gwtrm provided by oh-my-zsh git plugin)
gwtn() {
  local branch="$1"
  if [[ -z "$branch" ]]; then
    echo "usage: gwtn <branch>" >&2
    return 1
  fi
  local repo=$(basename "$(git rev-parse --show-toplevel)")
  local dir="$(git rev-parse --show-toplevel)/../${repo}__${branch//\//-}"
  if git show-ref --verify --quiet "refs/heads/$branch" || \
     git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    git worktree add "$dir" "$branch"
  else
    local main=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')
    git worktree add -b "$branch" "$dir" "${main:-main}"
  fi && cd "$dir"
}

reset-ssh() {
    sudo netstat -apn | grep -w 2224 | awk '{ print $7 }' | sed 's/\(.*\)\/.*/\1/' | sort -u | xargs -I{} kill -9 {};
}

_ssh_agent_maybe_launch() {
  if [[ -z "$SSH_AGENT_PID" ]]; then
    if command -v keychain > /dev/null 2>&1; then
      eval $(keychain --eval --quiet --inherit any)
    else
      eval $(ssh-agent -s) > /dev/null 2>&1
    fi
  fi
  _ssh_agent_attach_fixed_path
}

_ssh_agent_attach_fixed_path() {
  # Maintain symlink to socket (like Linux section does)
  if [[ -n "$SSH_AUTH_SOCK" && "$SSH_AUTH_SOCK" =~ ^/tmp/ ]]; then
    # Create symlink if it doesn't exist or points to wrong location
    if [[ ! -L ~/.ssh/ssh_auth_sock ]] || \
       [[ "$(readlink -f ~/.ssh/ssh_auth_sock)" != "$(readlink -f "$SSH_AUTH_SOCK")" ]]; then
	ln -sf "$SSH_AUTH_SOCK" ~/.ssh/ssh_auth_sock
    fi
  fi
}

