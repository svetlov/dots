_fcd_or_complete() {
    if [[ -z "$BUFFER" ]]; then
        local dir
        dir=$({
            if command -v zoxide &>/dev/null; then
                zoxide query -l 2>/dev/null | head -20
            fi
            find . -maxdepth 2 -type d 2>/dev/null | sed 's|^\./||'
        } | awk '!seen[$0]++' | fzf --height=40% --reverse)
        if [[ -n "$dir" ]]; then
            BUFFER="cd $dir"
            zle accept-line
        fi
    else
        zle expand-or-complete
    fi
}
zle -N _fcd_or_complete
bindkey '^I' _fcd_or_complete

