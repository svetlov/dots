export ZSH=${HOMEDIR}/.oh-my-zsh

if [[ ! -f ${ZSH}/oh-my-zsh.sh ]]; then
    # Remove broken/partial oh-my-zsh directory if it exists
    if [[ -d ${ZSH} && "${ZSH}" == */.oh-my-zsh && "${ZSH}" == ${HOME}/* ]]; then
        rm -rf ${ZSH}
    fi

    RUNZSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended

    [[ ! -d ${ZSH}/custom/plugins/fzf ]] && git clone https://github.com/junegunn/fzf.git ${ZSH}/custom/plugins/fzf;
    ${ZSH}/custom/plugins/fzf/install --bin;
    [[ ! -d ${ZSH}/custom/plugins/fzf-zsh ]] && git clone https://github.com/Treri/fzf-zsh.git ${ZSH}/custom/plugins/fzf-zsh;
    [[ ! -d ${ZSH}/custom/plugins/zsh-uv-env ]] && git clone https://github.com/matthiasha/zsh-uv-env.git ${ZSH}/custom/plugins/zsh-uv-env;
    _update_env;

